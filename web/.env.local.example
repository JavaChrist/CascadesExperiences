# Copie ce fichier en .env.local (gitignored) et remplis les valeurs.
# Tu trouves toutes ces clés dans Supabase Dashboard → Settings → API.

# URL du projet (publique, format https://abc123.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clé anon publique (bridée par RLS, OK côté client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service_role — SECRET ABSOLU. Bypass tous les RLS.
# Jamais exposée côté client. Ne pas commiter.
SUPABASE_SERVICE_ROLE_KEY=
